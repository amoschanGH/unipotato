@startuml Unipotato Public API
!theme plain
left to right direction

title Unipotato: Public API (Compact)

class Unipotato {
  - port: u16
  + launch(port: u16) : Self
  + mount(base: &str, routes_fn: F) : Self
  + start(self)
}

class Request {
  - inner: hyper::Request<Incoming>
  - params: HashMap<String, String>
  + with_params(inner, params) : Self
  + param(name: &str) : Option<&str>
  + query() : Query
  + into_body() : Result<Body, String>
}

class Query {
  + from_uri(uri: &Uri) : Self
  + get(key: &str) : Option<String>
  + has(key: &str) : bool
}

class Body {
  + as_str() : Result<&str, String>
  + json<T: DeserializeOwned>() : Result<T, String>
  + form() : Result<HashMap<String, String>, String>
}

class HandlerHelpers <<functions>> {
  + text(body) : Response<String>
  + html(body) : Response<String>
  + json(data) : Response<String>
  + not_found() : Response<String>
}

class HTTPRouteMacros <<macro layer>> {
  + #[get|post|put|delete|patch](path)
  + routes![...]
  + launch!(port)
}

HTTPRouteMacros --> Unipotato : configures routes for
HTTPRouteMacros --> Request : generates handler signature for
Request --> Query : parses query
Request --> Body : reads body
Unipotato ..> HandlerHelpers : handlers return

@enduml

@startuml Unipotato Runtime Routing
!theme plain
left to right direction

title Unipotato: Runtime Routing (Compact)

class Unipotato {
  + start(self)
  - launch_internal()
}

class Router {
  + route(req: hyper::Request<Incoming>) : Response<String>
  + not_found() : Response<String>
}

class RouteApi <<module facade>> {
  + register_route(method, original_path, pattern, handler)
  + find_handler_with_params(method, path) : Option<HandlerMatch>
  + collect_routes() : Vec<Route>
}

class RouteInfo {
  - method: Method
  - original_path: String
  - pattern: Regex
  - is_static: bool
}

class HandlerMatch {
  + handler: Handler
  + params: HashMap<String, String>
}

class RouteStorage <<internal>> {
  {static} ROUTES: DashMap<Method, Vec<RouteInfo>>
  {thread_local} MOUNT_BASE: RefCell<String>
  {thread_local} ROUTE_CACHE: LruCache<u64, CachedHandlerMatch>
}

class Handler <<type alias>> {
  Arc<dyn Fn(Request) -> Future<Response<String>> + Send + Sync>
}

Unipotato --> Router : serves requests with
Router --> RouteApi : delegates lookup to
RouteApi --> HandlerMatch : returns
RouteApi --> RouteStorage : reads and writes
RouteStorage --> RouteInfo : stores
HandlerMatch --> Handler : contains

note bottom of RouteApi
  Fast path: static routes use string equality.
  Dynamic routes use regex + extracted params.
end note

@enduml
