@startuml Unipotato Request Handling Sequence
!theme plain
scale 0.8
title Unipotato Request Handling
actor Client
participant "Async Runtime\n(Tokio + Hyper)" as Runtime
participant "Router" as Router
participant "Route Registry" as Registry
participant "Request Wrapper" as Request
participant "Handler Function" as Handler
participant "Response Helper" as Response
== Incoming Request ==
Client -> Runtime: HTTP GET /api/users/123
activate Runtime
== Route Matching ==
Runtime -> Router: router(hyper::Request)
activate Router
Router -> Router: extract method and path
note right: GET, /api/users/123
Router -> Registry: find_handler_with_params(GET, "/api/users/123")
activate Registry
Registry -> Registry: match route and extract params
Registry --> Router: HandlerMatch { handler, id: "123" }
deactivate Registry
== Request Handling ==
Router -> Request: Request::with_params(hyper_req, params)
activate Request
Request --> Router: custom_request
deactivate Request
Router -> Handler: handler(custom_request).await
activate Handler
Handler -> Request: req.param_as<u64>("id")
Request --> Handler: Some(123)
Handler -> Handler: run business logic
== Response ==
Handler -> Response: json(user_data)
activate Response
Response -> Response: serialize and set headers
Response --> Handler: hyper::Response (200 OK)
deactivate Response
Handler --> Router: Response  
deactivate Handler
Router --> Runtime: Ok(Response)
deactivate Router
Runtime --> Client: HTTP/1.1 200 OK\nContent-Type: application/json\n{...}
deactivate Runtime
note over Registry
  Thread-safe global route registry
end note
@enduml
